# P31 Capital Machine — Environment Variables

# Core
ENVIRONMENT=development

# Ethereum RPC Endpoints
RPC_URL_ETH=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_ARB=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Solana RPC Endpoint
RPC_URL_SOL=https://api.mainnet-beta.solana.com

# Cosmos RPC Endpoint
RPC_URL_COSMOS=https://rpc.cosmos.network

# Private Keys (hex for EVM, base58 for Solana)
PRIVATE_KEY_ETH=0x...
PRIVATE_KEY_SOL=...

# Flashbots / MEV
FLASHBOTS_RELAY=https://relay.flashbots.net
JITO_TIP_KEY=

# AI / ML
OPENAI_API_KEY=sk-...

# Social / Notifications
DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Email
EMAIL_API_KEY=

# Scraping
SCRAPINGBEE_API_KEY=

# Affiliate
COINREBATE_API_KEY=

# Auth
JWT_SECRET=your-jwt-secret-here

# Wallet (Cosmos)
WALLET_MNEMONIC="..."

# DeFi Protocol Addresses
AAVE_POOL_ADDRESS=0x...
COMPOUND_COMPTROLLER=0x...
MORPHO_VAULT_ADDRESS=0x...

# MEV Settings
MIN_PROFIT_BPS=200
